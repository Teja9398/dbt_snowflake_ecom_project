
with products as (

      select distinct
            product_id,
            product_category_name,
            product_photos_qty,
            nullif(product_weight_g, 0) as product_weight_g,
            product_length_cm,
            product_height_cm,
            product_width_cm,
            product_volume_cm3
      from {{ ref("int_order_items_enriched") }}

),

final as (

      select
            product_id,
            product_category_name,
            product_photos_qty,
            product_weight_g,
            product_length_cm,
            product_height_cm,
            product_width_cm,
            product_volume_cm3
      from products

)

select * from final